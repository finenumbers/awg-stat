POSTGRES_PASSWORD=
APP_URL=https://gate.example.com
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=
GEOIP_API_URL=
GEOIP_API_KEY=
GATE_DOCKER_AGENT_TOKEN=
GATE_AWG_TOKEN=
# Disable TSPU / cheburcheck probes from the poller.
# GATE_BLOCK_CHECK=0
# Cheburcheck API token for scanner probes. Empty keeps the last verdict.
# Request one at https://cheburcheck.ru/kb/api — a zero credit balance is enough.
# A positive balance spends one credit on every probe, including cached replies.
# The rollback below also needs this value on gate-app.
GATE_CHEBURCHECK_TOKEN=
# Rollback only: set GATE_RUN_POLLER=1 on gate-app if gate-poller is down.
# GATE_RUN_POLLER=1
